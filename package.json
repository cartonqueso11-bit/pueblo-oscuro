
{
  "name": "pueblo-oscuro",
  "version": "1.0.0",
  "description": "Pueblo Oscuro - videojuego pixel art",
  "main": "main.js",
  "author": "Pueblo Oscuro",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.pueblooscuro.game",
    "productName": "Pueblo Oscuro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "Pueblo-Oscuro-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
